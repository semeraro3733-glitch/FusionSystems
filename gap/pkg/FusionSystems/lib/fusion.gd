#############################################################################
##
##  fusion.gd              FusionSystems package
##
##  Fusion systems given by generating automizers.
##
##  A fusion system F on the p-group S is specified by
##     Aut_F(S)          (a subgroup of Aut(S) containing Inn(S)),
##     E_1, ..., E_k     subgroups of S (the essential subgroups), and
##     Aut_F(E_i)        subgroups of Aut(E_i),
##  and is the fusion system generated by these automorphism groups.
##
DeclareCategory( "IsFusionSystem", IsObject );
DeclareRepresentation( "IsFusionSystemRep", IsComponentObjectRep and IsAttributeStoringRep, [] );
BindGlobal( "FusionSystemFamily", NewFamily( "FusionSystemFamily", IsFusionSystem ) );
BindGlobal( "FusionSystemType", NewType( FusionSystemFamily, IsFusionSystem and IsFusionSystemRep ) );

DeclareGlobalFunction( "FusionSystem" );
DeclareGlobalFunction( "FusionSystemByAutomizers" );

DeclareAttribute( "UnderlyingGroup", IsFusionSystem );
DeclareAttribute( "PrimeOfFusionSystem", IsFusionSystem );
DeclareAttribute( "EssentialSubgroups", IsFusionSystem );
DeclareAttribute( "EssentialAutomizers", IsFusionSystem );
DeclareAttribute( "AutomizerOfS", IsFusionSystem );
DeclareAttribute( "OutFSOrder", IsFusionSystem );
DeclareAttribute( "FusionSystemGroup", IsFusionSystem );

DeclareGlobalFunction( "FS_NodeOf" );
DeclareGlobalFunction( "FS_ExpandNode" );
DeclareGlobalFunction( "FS_ComponentOf" );
DeclareGlobalFunction( "FS_EssentialSConjugates" );
DeclareGlobalFunction( "FS_AutFGeneratorsOfNode" );
DeclareGlobalFunction( "FS_AutFGenerators" );
DeclareGlobalFunction( "FS_ComplementData" );
DeclareGlobalFunction( "FS_BClassPosition" );
DeclareGlobalFunction( "FS_AutSGenerators" );
DeclareGlobalFunction( "FS_IsoToNode" );

DeclareOperation( "AutF", [ IsFusionSystem, IsGroup ] );
DeclareOperation( "FConjugacyClass", [ IsFusionSystem, IsGroup ] );
DeclareOperation( "IsFConjugate", [ IsFusionSystem, IsGroup, IsGroup ] );
DeclareOperation( "FIsomorphism", [ IsFusionSystem, IsGroup, IsGroup ] );
DeclareOperation( "IsFCentric", [ IsFusionSystem, IsGroup ] );
DeclareOperation( "IsFullyNormalized", [ IsFusionSystem, IsGroup ] );
DeclareOperation( "IsFullyCentralized", [ IsFusionSystem, IsGroup ] );
DeclareOperation( "IsFullyAutomized", [ IsFusionSystem, IsGroup ] );
DeclareOperation( "IsFRadical", [ IsFusionSystem, IsGroup ] );
