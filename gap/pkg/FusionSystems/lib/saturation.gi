#############################################################################
##
##  saturation.gi          FusionSystems package
##
##  Saturation is tested with the criterion of Parker-Semeraro
##  [arXiv:2003.01600, Theorem 2.3] (which rests on [BCGLO, Theorem 2.2]):
##  a fusion system F on S generated by Aut_F(S) and the automizers of
##  F-centric subgroups E_1, ..., E_k is saturated if and only if
##   (1) Inn(S) is a Sylow p-subgroup of Aut_F(S),
##   (2) every fully normalized F-centric subgroup P is fully automized, and
##   (3) every fully normalized F-centric F-radical subgroup P satisfies the
##       surjectivity property: for all P < V <= N_S(P) the restriction map
##       N_{Aut_F(V)}(P) -> N_{Aut_F(P)}(Aut_V(P)) is surjective.
##
##  The fusion graph of Parker-Semeraro is avoided as follows.  Let B be
##  the semidirect product Aut_F(S) x| S and let T be the set of subgroups
##  of S contained in a B-conjugate of some E_i.  T is closed under
##  F-conjugacy and under taking subgroups, and for P not in T every
##  F-morphism with source P is the restriction of a conjugation by an
##  element of B.  Hence the F-class, Aut_F(P) and the extension condition
##  for such P are those of the (saturated) fusion system F_S(B), and (2)
##  and (3) hold automatically.  It therefore suffices to run (2) and (3)
##  over the F-classes of S-centric subgroups of the E_i, which are found
##  through the subgroup lattices of E_i/Z(E_i) (never that of S), and
##  their F-classes and automizers are computed lazily by the groupoid
##  closure in fusion.gi.
##

#############################################################################
##
#F  FS_CentricClassesInEssentials( <F> )
##
##  The nodes (one per S-conjugacy class) of the S-centric subgroups of
##  the essential subgroups, together with the node of S.
##
InstallGlobalFunction( FS_CentricClassesInEssentials, function( F )
    local S, nodes, i, E, Z, q, Ebar, induced, cls, U, pos, h;
    S := F!.S;
    nodes := [ FS_NodeOf( F, S )[1] ];
    for i in [ 1 .. Length( F!.ess ) ] do
        E := F!.ess[i];
        Z := Center( E );
        if Size( Z ) = Size( E ) then
            cls := [ E ];
        else
            q := NaturalHomomorphismByNormalSubgroup( E, Z );
            Ebar := Image( q );
            induced := List( F!.essauts[i], a -> FS_InducedAutOnQuotient( a, q ) );
            induced := Filtered( induced, a -> not IsOne( a ) );
            cls := SubgroupsSolvableGroup( Ebar, rec( actions := induced ) );
            cls := List( cls, U -> PreImage( q, U ) );
        fi;
        for U in cls do
            if FS_IsCentricIn( S, U ) then
                pos := FS_NodeOf( F, U );
                AddSet( nodes, pos[1] );
            fi;
        od;
    od;
    return nodes;
end );

#############################################################################
##
#M  HasSurjectivityProperty( <F>, <P> )
##
##  For every V with P < V <= N_S(P): the automorphisms of P which extend
##  to F-automorphisms of V are exactly the elements of Aut_F(P)
##  normalizing Aut_V(P).  (For F-centric P this is equivalent to the
##  extension axiom for the F-automorphisms of P.)
##
InstallMethod( HasSurjectivityProperty, [ IsFusionSystem, IsGroup ], function( F, P )
    local S, N, h, A, overs, V, hV, AV, stab, res, nor, autV;
    S := F!.S;
    N := Normalizer( S, P );
    if N = P then return true; fi;
    h := FS_AutHandle( P );
    A := FS_AutSubgroup( h, Concatenation( FS_AutSGenerators( F, P ), FS_AutFGenerators( F, P ) ) );
    overs := FS_SubgroupsContaining( N, P );
    for V in overs do
        hV := FS_AutHandle( V );
        AV := FS_AutSubgroup( hV, Concatenation( FS_AutSGenerators( F, V ), FS_AutFGenerators( F, V ) ) );
        stab := FS_AutStabilizer( hV, AV, P );
        res := FS_AutSubgroup( h, List( GeneratorsOfGroup( stab ), x -> FS_RestrictAut( hV.from( x ), P ) ) );
        autV := FS_AutSubgroup( h, List( GeneratorsOfGroup( V ), g -> ConjugatorAutomorphismNC( P, g ) ) );
        nor := Normalizer( A, autV );
        if Size( res ) <> Size( nor ) then
            Info( InfoFusionSystems, 2, "surjectivity property fails for P of order ", Size( P ),
                  " and V of order ", Size( V ), ": ", Size( res ), " extend, normalizer has order ", Size( nor ) );
            return false;
        fi;
    od;
    return true;
end );

InstallMethod( IsReceptive, [ IsFusionSystem, IsGroup ], function( F, P )
    return IsFullyAutomized( F, P ) and HasSurjectivityProperty( F, P );
end );

#############################################################################
##
#F  FS_IsSaturatedWithReason( <F> ) . . . . . . [ true ] or [ false, reason ]
##
InstallGlobalFunction( FS_IsSaturatedWithReason, function( F )
    local S, p, cpl, nodes, comps, i, j, r, comp, best, P, h, A, T, essnodes, pos, pp, nSE;
    S := F!.S; p := F!.p;
    cpl := FS_ComplementData( F );
    if not cpl.sylow then
        return [ false, "Inn(S) is not a Sylow p-subgroup of Aut_F(S)" ];
    fi;
    # the essential subgroups must be fully normalized and F-centric
    essnodes := List( F!.ess, E -> FS_NodeOf( F, E )[1] );
    for i in [ 1 .. Length( essnodes ) ] do
        nSE := F!.nodes[ essnodes[i] ].nS;
        # the F-class of E_i is expanded only until a member which is not
        # S-centric or has a larger normalizer in S turns up
        comp := FS_ComponentWithStop( F, essnodes[i], node -> not node.centric or node.nS > nSE );
        if comp = fail then
            if not F!.nodes[ F!.stopnode ].centric then
                return [ false, Concatenation( "essential subgroup ", String( i ), " is not F-centric" ) ];
            fi;
            return [ false, Concatenation( "essential subgroup ", String( i ), " is not fully normalized" ) ];
        fi;
    od;
    nodes := FS_CentricClassesInEssentials( F );
    comps := [];
    for i in nodes do
        r := FS_Find( F, i );
        if not IsBound( comps[r] ) then
            # the class matters only if it is F-centric: give up at the
            # first member which is not S-centric
            comps[r] := FS_ComponentWithStop( F, i, node -> not node.centric );
        fi;
    od;
    for r in [ 1 .. Length( comps ) ] do
        if not IsBound( comps[r] ) or comps[r] = fail then continue; fi;
        comp := comps[r];
        # a fully normalized representative
        best := comp[1];
        for j in comp do if F!.nodes[j].nS > F!.nodes[ best ].nS then best := j; fi; od;
        P := F!.nodes[ best ].rep;
        h := FS_AutHandle( P );
        T := FS_AutSubgroup( h, FS_AutSGenerators( F, P ) );
        A := SubgroupNC( h.model, Concatenation( GeneratorsOfGroup( T ), List( FS_AutFGeneratorsOfNode( F, best ), h.to ) ) );
        pp := FS_PPart( Size( A ), p );
        if pp <> Size( T ) then
            return [ false, Concatenation( "a subgroup of order ", String( Size( P ) ),
                     " is not fully automized: |Aut_S(P)| = ", String( Size( T ) ), ", |Aut_F(P)|_p = ", String( pp ) ) ];
        fi;
        if P = S then continue; fi;
        # F-radical?  O_p(Aut_F(P)) = Inn(P)
        if Size( PCore( A, p ) ) <> Index( P, Center( P ) ) then continue; fi;
        if not HasSurjectivityProperty( F, P ) then
            return [ false, Concatenation( "the surjectivity property fails at a subgroup of order ", String( Size( P ) ) ) ];
        fi;
    od;
    return [ true ];
end );

InstallGlobalFunction( FS_SaturationTest, F -> FS_IsSaturatedWithReason( F )[1] );

InstallMethod( IsSaturated, [ IsFusionSystem ], function( F )
    local r;
    r := FS_IsSaturatedWithReason( F );
    if not r[1] then Info( InfoFusionSystems, 1, "not saturated: ", r[2] ); fi;
    return r[1];
end );

#############################################################################
##
#F  FS_CommutatorWithAutomorphisms( <P>, <auts> ) . . [P, A] for A = < auts >
##
##  The normal closure in P of < x^-1 a(x) : x generator of P, a in auts >.
##
InstallGlobalFunction( FS_CommutatorWithAutomorphisms, function( P, auts )
    local gens, a, x;
    gens := [];
    for a in auts do
        for x in GeneratorsOfGroup( P ) do
            Add( gens, x^-1 * ImagesRepresentative( a, x ) );
        od;
    od;
    return NormalClosure( P, SubgroupNC( P, gens ) );
end );

#############################################################################
##
#M  FocalSubgroup( <F> ) . . . . . < [S, Aut_F(S)], [E_i, Aut_F(E_i)] : i >
##
InstallMethod( FocalSubgroup, [ IsFusionSystem ], function( F )
    local S, foc, i;
    S := F!.S;
    foc := ClosureGroup( DerivedSubgroup( S ), FS_CommutatorWithAutomorphisms( S, F!.autSgens ) );
    for i in [ 1 .. Length( F!.ess ) ] do
        foc := ClosureGroup( foc, FS_CommutatorWithAutomorphisms( F!.ess[i], F!.essauts[i] ) );
    od;
    return foc;
end );

InstallMethod( IsPPerfectFusionSystem, [ IsFusionSystem ], F -> Size( FocalSubgroup( F ) ) = Size( F!.S ) );

#############################################################################
##
#M  OpF( <F> )
##
##  The largest subgroup Q of S which is normal in S, contained in every
##  essential subgroup and invariant under Aut_F(S) and all Aut_F(E_i).
##  For saturated F this is O_p(F).
##
InstallMethod( OpF, [ IsFusionSystem ], function( F )
    local S, Q, i, conj, auts;
    S := F!.S;
    Q := S;
    for i in [ 1 .. Length( F!.ess ) ] do
        Q := Intersection( Q, Core( S, F!.ess[i] ) );
    od;
    auts := Concatenation( FS_InnerAutGenerators( S ), F!.autSgens, Concatenation( F!.essauts ) );
    return FS_LargestInvariantSubgroup( Q, auts );
end );

InstallMethod( IsOpFTrivial, [ IsFusionSystem ], F -> Size( OpF( F ) ) = 1 );
