#############################################################################
##
##  fusion.gi              FusionSystems package
##
##  Internal structure of a fusion system object F (components of F!.):
##
##    S          the p-group (a pc group),
##    p          the prime,
##    autSgens   automorphisms of S which together with Inn(S) generate Aut_F(S),
##    ess        list of essential subgroups E_i,
##    essauts    list of lists of automorphisms generating Aut_F(E_i),
##    cpl        (lazy) record of a complement C to Inn(S) in Aut_F(S):
##               gens (automorphisms), elts (all elements as automorphisms),
##               model (subgroup of the Aut(S) model), sylow (true iff Inn(S)
##               is a Sylow p-subgroup of Aut_F(S)),
##    nodes      list of node records, one for each S-conjugacy class of
##               subgroups of S met so far:
##                 rep       the class representative,
##                 inv       its invariants,
##                 nS        |N_S(rep)|,
##                 centric   true iff rep is S-centric,
##                 expanded  true once the edges have been computed,
##                 edges     list of rec( to, map ) with map: rep -> nodes[to].rep
##                           an isomorphism in F,
##                 parent    union-find parent (F-conjugacy),
##                 autF      (lazy) generators of Aut_F(rep),
##    nodeinv    the list of invariants of the nodes (for fast lookup),
##    essconj    (lazy) essconj[i] = list of rec( grp, auts ) for the
##               S-conjugates of E_i with transported automizer generators,
##    comps      (lazy) cache of computed components.
##
##  Fusion of subgroups.  Let B = Aut_F(S) x| S.  Every isomorphism in F
##  between subgroups of S is a composite of restrictions of elements of
##  Aut_F(S) and of Aut_F(E_i^s) = (Aut_F(E_i))^{c_s}, s in S.  The nodes
##  are the S-classes of subgroups; at a node with representative R we
##  record the arrows  R -> rep(c(R))  for the generators c of C, and
##  R -> rep(a(R))  for the generators a of Aut_F(E_i^s) whenever
##  R <= E_i^s.  Together with Aut_S(R) at every node these arrows generate
##  the groupoid of all F-isomorphisms between the subgroups in the
##  F-class of R (Reidemeister-Schreier for groupoids), so the F-class of R
##  is the connected component of its node and Aut_F(R) is generated by
##  the conjugates of the vertex groups Aut_S(X) and the loops.
##

#############################################################################
##
#F  FusionSystem( <S>, <autSgens>, <essentials>, <essautos> )
##
InstallGlobalFunction( FusionSystem, function( S, autSgens, essentials, essautos )
    local F, i, A;
    if not IsPcGroup( S ) then
        Error( "<S> must be a pc group; use IsomorphismPcGroup first" );
    fi;
    if Length( essentials ) <> Length( essautos ) then
        Error( "<essentials> and <essautos> must have the same length" );
    fi;
    if IsGroup( autSgens ) then autSgens := GeneratorsOfGroup( autSgens ); fi;
    essautos := ShallowCopy( essautos );
    for i in [ 1 .. Length( essautos ) ] do
        A := essautos[i];
        if IsGroup( A ) then A := GeneratorsOfGroup( A ); fi;
        essautos[i] := Filtered( A, a -> not IsOne( a ) );
    od;
    F := Objectify( FusionSystemType, rec(
        S := S, p := PrimePGroup( S ),
        autSgens := Filtered( autSgens, a -> not IsOne( a ) ),
        ess := ShallowCopy( essentials ), essauts := essautos,
        nodes := [], nodeinv := [], comps := rec() ) );
    return F;
end );

InstallGlobalFunction( FusionSystemByAutomizers, function( autos )
    local S;
    S := Source( GeneratorsOfGroup( autos[1] )[1] );
    return FusionSystem( S, autos[1], List( autos{[ 2 .. Length( autos ) ]}, A -> Source( GeneratorsOfGroup( A )[1] ) ),
                         autos{[ 2 .. Length( autos ) ]} );
end );

InstallMethod( UnderlyingGroup, [ IsFusionSystem ], F -> F!.S );
InstallMethod( PrimeOfFusionSystem, [ IsFusionSystem ], F -> F!.p );
InstallMethod( EssentialSubgroups, [ IsFusionSystem ], F -> F!.ess );
InstallMethod( EssentialAutomizers, [ IsFusionSystem ], function( F )
    return List( [ 1 .. Length( F!.ess ) ], i -> FS_AutGroupByGenerators( F!.essauts[i], F!.ess[i] ) );
end );
InstallMethod( AutomizerOfS, [ IsFusionSystem ], function( F )
    return FS_AutGroupByGenerators( Concatenation( FS_InnerAutGenerators( F!.S ), F!.autSgens ), F!.S );
end );
InstallMethod( OutFSOrder, [ IsFusionSystem ], F -> Size( FS_ComplementData( F ).model ) );

InstallMethod( ViewObj, [ IsFusionSystem ], function( F )
    Print( "<fusion system on a group of order ", F!.p, "^", LogInt( Size( F!.S ), F!.p ),
           " with ", Length( F!.ess ), " essential classes>" );
end );

InstallMethod( PrintObj, [ IsFusionSystem ], function( F )
    local i, h;
    Print( "Fusion system on a group S of order ", F!.p, "^", LogInt( Size( F!.S ), F!.p ), "\n" );
    if HasFusionSystemGroup( F ) then
        Print( "  the fusion system of ", FusionSystemGroup( F ), "\n" );
    fi;
    Print( "  |Out_F(S)| = ", OutFSOrder( F ), "\n" );
    Print( "  ", Length( F!.ess ), " classes of essential subgroups" );
    if Length( F!.ess ) > 0 then
        Print( " of orders ", List( F!.ess, Size ), " with |Out_F(E)| = ",
               List( [ 1 .. Length( F!.ess ) ], i -> Size( EssentialAutomizers( F )[i] ) / Index( F!.ess[i], Center( F!.ess[i] ) ) ) );
    fi;
    Print( "\n" );
end );

#############################################################################
##
#F  FS_ComplementData( <F> )
##
##  A complement C to Inn(S) in Aut_F(S) (which exists iff Inn(S) is a
##  normal Sylow p-subgroup, i.e. iff Aut_F(S)/Inn(S) is a p'-group).
##
InstallGlobalFunction( FS_ComplementData, function( F )
    local S, h, inn, A, pp, C, cpl;
    if IsBound( F!.cpl ) then return F!.cpl; fi;
    S := F!.S;
    h := FS_AutHandle( S );
    inn := h.inn;
    A := SubgroupNC( h.model, Concatenation( GeneratorsOfGroup( inn ), List( F!.autSgens, h.to ) ) );
    pp := FS_PPart( Size( A ), F!.p );
    cpl := rec( autF := A, sylow := ( pp = Size( inn ) ) );
    if cpl.sylow then
        if Size( A ) = Size( inn ) then
            C := TrivialSubgroup( h.model );
        elif IsSolvableGroup( A ) then
            C := HallSubgroup( A, Difference( PrimeDivisors( Size( A ) ), [ F!.p ] ) );
        else
            C := ComplementClassesRepresentatives( A, inn )[1];
        fi;
        cpl.model := C;
        cpl.gens := List( GeneratorsOfGroup( C ), h.from );
    else
        cpl.model := fail;
        cpl.gens := fail;
    fi;
    F!.cpl := cpl;
    return cpl;
end );

#############################################################################
##
#F  FS_ComplementElements( <F> ) . . . . all elements of the complement as automorphisms
##
BindGlobal( "FS_ComplementElements", function( F )
    local cpl, h;
    cpl := FS_ComplementData( F );
    if not IsBound( cpl.elts ) then
        h := FS_AutHandle( F!.S );
        cpl.elts := List( Elements( cpl.model ), h.from );
    fi;
    return cpl.elts;
end );

#############################################################################
##
#F  FS_AutSGenerators( <F>, <P> ) . . . . . . . . . . generators of Aut_S(P)
##
InstallGlobalFunction( FS_AutSGenerators, function( F, P )
    return List( GeneratorsOfGroup( Normalizer( F!.S, P ) ), g -> ConjugatorAutomorphismNC( P, g ) );
end );

#############################################################################
##
#F  FS_NodeOf( <F>, <X> ) . . . . . . . [ i, s ] with X^s = F!.nodes[i].rep
##
InstallGlobalFunction( FS_NodeOf, function( F, X )
    local S, pos, inv, node;
    S := F!.S;
    pos := FS_ClassPosition( S, List( F!.nodes, n -> n.rep ), F!.nodeinv, X );
    if pos <> fail then return pos; fi;
    inv := FS_SubgroupInvariants( S, X );
    node := rec( rep := X, inv := inv, nS := inv[2], centric := ( inv[3] <= Size( X ) and IsSubset( X, Centralizer( S, X ) ) ),
                 expanded := false, cpldone := false, done := [], edges := [], parent := Length( F!.nodes ) + 1 );
    Add( F!.nodes, node );
    Add( F!.nodeinv, inv );
    return [ Length( F!.nodes ), One( S ) ];
end );

#############################################################################
##
#F  FS_EssentialSConjugates( <F> )
##
InstallGlobalFunction( FS_EssentialSConjugates, function( F )
    local S, i, E, N, T, list, s, theta, conj;
    if IsBound( F!.essconj ) then return F!.essconj; fi;
    S := F!.S;
    F!.essconj := [];
    for i in [ 1 .. Length( F!.ess ) ] do
        E := F!.ess[i];
        N := Normalizer( S, E );
        list := [];
        for s in RightTransversal( S, N ) do
            conj := ConjugateSubgroup( E, s );
            if s = One( S ) or conj = E then
                Add( list, rec( grp := E, auts := F!.essauts[i] ) );
            else
                theta := GroupHomomorphismByImagesNC( E, conj, FS_PcgsOf( E ), List( FS_PcgsOf( E ), x -> x^s ) );
                Add( list, rec( grp := conj, auts := List( F!.essauts[i], a -> FS_TransportAut( a, theta ) ) ) );
            fi;
        od;
        Add( F!.essconj, list );
    od;
    return F!.essconj;
end );

#############################################################################
##
#F  FS_Find( <F>, <i> ) . . . . . . . . . . . . . . . . . . union-find root
##
BindGlobal( "FS_Find", function( F, i )
    local r, j, nodes;
    nodes := F!.nodes;
    r := i;
    while nodes[r].parent <> r do r := nodes[r].parent; od;
    while nodes[i].parent <> r do j := nodes[i].parent; nodes[i].parent := r; i := j; od;
    return r;
end );

BindGlobal( "FS_Union", function( F, i, j )
    local ri, rj;
    ri := FS_Find( F, i ); rj := FS_Find( F, j );
    if ri <> rj then F!.nodes[ Maximum( ri, rj ) ].parent := Minimum( ri, rj ); fi;
end );

#############################################################################
##
#F  FS_AddEdge( <F>, <i>, <a>, <Y> )
##
##  a an injective homomorphism from nodes[i].rep onto Y; records the arrow
##  nodes[i].rep -> rep( Y ).
##
BindGlobal( "FS_AddEdge", function( F, i, a, Y )
    local pos, R, gens, map;
    pos := FS_NodeOf( F, Y );
    R := F!.nodes[i].rep;
    gens := FS_PcgsOf( R );
    if pos[2] = One( F!.S ) then
        map := GroupHomomorphismByImagesNC( R, F!.nodes[ pos[1] ].rep, gens, List( gens, x -> ImagesRepresentative( a, x ) ) );
    else
        map := GroupHomomorphismByImagesNC( R, F!.nodes[ pos[1] ].rep, gens, List( gens, x -> ImagesRepresentative( a, x ) ^ pos[2] ) );
    fi;
    Add( F!.nodes[i].edges, rec( to := pos[1], map := map ) );
    FS_Union( F, i, pos[1] );
end );

#############################################################################
##
#F  FS_ProcessOrbit( <F>, <i>, <k>, <m> )
##
##  Let Et = essconj[k][m].grp be an S-conjugate of the k-th essential
##  subgroup containing the representative R of node i.  Computes the
##  orbit of R under Aut_F(Et) (as subgroups of Et) and records, for every
##  member Y of the orbit and every generator g of Aut_F(Et), the arrow
##  rep(Y) -> rep(g(Y)) obtained from g by conjugating into the class
##  representatives.  These arrows form the Schreier graph of the orbit, so
##  that the closure of the arrows generates all of the fusion induced by
##  Aut_F(Et) on the orbit (this is what the generators applied to the
##  representatives alone would not achieve, as conjugation by elements of
##  S does not normalize Et).  Every node met is marked as processed for
##  the corresponding conjugate of the essential subgroup.
##
BindGlobal( "FS_ProcessOrbit", function( F, i, k, m )
    local S, data, Et, gens, R, orbit, pos, imgs, y, g, Z, z, ny, nz, gensY, map, conjlist, idx, cnj;
    S := F!.S;
    conjlist := FS_EssentialSConjugates( F )[k];
    data := conjlist[m];
    Et := data.grp; gens := data.auts;
    R := F!.nodes[i].rep;
    orbit := [ R ];
    pos := [ FS_NodeOf( F, R ) ];
    imgs := [];
    y := 1;
    while y <= Length( orbit ) do
        imgs[y] := [];
        for g in [ 1 .. Length( gens ) ] do
            Z := ImagesSet( gens[g], orbit[y] );
            z := Position( orbit, Z );
            if z = fail then
                Add( orbit, Z );
                Add( pos, FS_NodeOf( F, Z ) );
                z := Length( orbit );
            fi;
            imgs[y][g] := z;
        od;
        y := y + 1;
    od;
    # mark the pairs ( node, conjugate ) as processed and add the arrows
    for y in [ 1 .. Length( orbit ) ] do
        ny := pos[y][1];
        # the conjugate of Et containing the representative of node ny
        cnj := ConjugateSubgroup( Et, pos[y][2] );
        idx := PositionProperty( conjlist, r -> r.grp = cnj );
        AddSet( F!.nodes[ ny ].done, [ k, idx ] );
        gensY := FS_PcgsOf( F!.nodes[ ny ].rep );
        for g in [ 1 .. Length( gens ) ] do
            z := imgs[y][g];
            nz := pos[z][1];
            map := GroupHomomorphismByImagesNC( F!.nodes[ ny ].rep, F!.nodes[ nz ].rep, gensY,
                      List( gensY, x -> ImagesRepresentative( gens[g], x ^ ( pos[y][2]^-1 ) ) ^ pos[z][2] ) );
            Add( F!.nodes[ ny ].edges, rec( to := nz, map := map ) );
            FS_Union( F, ny, nz );
        od;
    od;
end );

#############################################################################
##
#F  FS_ExpandNode( <F>, <i> )
##
InstallGlobalFunction( FS_ExpandNode, function( F, i )
    local node, R, cpl, c, conj, k, m;
    node := F!.nodes[i];
    if node.expanded then return; fi;
    R := node.rep;
    cpl := FS_ComplementData( F );
    if cpl.gens = fail then
        Error( "Inn(S) is not a Sylow p-subgroup of Aut_F(S)" );
    fi;
    if not node.cpldone then
        for c in cpl.gens do
            FS_AddEdge( F, i, c, ImagesSet( c, R ) );
        od;
        node.cpldone := true;
    fi;
    conj := FS_EssentialSConjugates( F );
    for k in [ 1 .. Length( conj ) ] do
        for m in [ 1 .. Length( conj[k] ) ] do
            if Size( conj[k][m].grp ) >= Size( R ) and not [ k, m ] in node.done
               and IsSubset( conj[k][m].grp, R ) then
                FS_ProcessOrbit( F, i, k, m );
            fi;
        od;
    od;
    node.expanded := true;
end );

#############################################################################
##
#F  FS_ComponentOf( <F>, <i> ) . . . . . . .  the node numbers of the F-class of node i
##
InstallGlobalFunction( FS_ComponentOf, function( F, i )
    local seen, queue, j, e, comp;
    # expand until closure
    seen := [ i ]; queue := [ i ];
    while Length( queue ) > 0 do
        j := Remove( queue );
        FS_ExpandNode( F, j );
        for e in F!.nodes[j].edges do
            if not e.to in seen then AddSet( seen, e.to ); Add( queue, e.to ); fi;
        od;
    od;
    return seen;
end );

#############################################################################
##
#F  FS_IsoToNode( <F>, <comp>, <i> )
##
##  A spanning tree of the component comp rooted at node i: returns a list
##  theta with theta[j] = [ map i -> j, map j -> i ] (isomorphisms in F
##  between the representatives) for j in comp.
##
InstallGlobalFunction( FS_IsoToNode, function( F, comp, i )
    local theta, queue, j, e, R, gens, m, back;
    R := F!.nodes[i].rep;
    gens := FS_PcgsOf( R );
    theta := [];
    theta[i] := [ IdentityMapping( R ), IdentityMapping( R ) ];
    queue := [ i ];
    while Length( queue ) > 0 do
        j := Remove( queue, 1 );
        for e in F!.nodes[j].edges do
            if not IsBound( theta[ e.to ] ) then
                m := GroupHomomorphismByImagesNC( R, F!.nodes[ e.to ].rep, gens,
                        List( gens, x -> ImagesRepresentative( e.map, ImagesRepresentative( theta[j][1], x ) ) ) );
                back := FS_InverseIso( m );
                theta[ e.to ] := [ m, back ];
                Add( queue, e.to );
            fi;
        od;
    od;
    return theta;
end );

#############################################################################
##
#F  FS_AutFGeneratorsOfNode( <F>, <i> ) . . . . generators of Aut_F( nodes[i].rep )
##
InstallGlobalFunction( FS_AutFGeneratorsOfNode, function( F, i )
    local node, comp, theta, R, gens, res, j, g, e, X, imgs;
    node := F!.nodes[i];
    if IsBound( node.autF ) then return node.autF; fi;
    comp := FS_ComponentOf( F, i );
    theta := FS_IsoToNode( F, comp, i );
    R := node.rep;
    gens := FS_PcgsOf( R );
    res := [];
    for j in comp do
        X := F!.nodes[j].rep;
        # conjugates of the vertex group Aut_S(X)
        for g in GeneratorsOfGroup( Normalizer( F!.S, X ) ) do
            imgs := List( gens, x -> ImagesRepresentative( theta[j][2], ImagesRepresentative( theta[j][1], x ) ^ g ) );
            Add( res, GroupHomomorphismByImagesNC( R, R, gens, imgs ) );
        od;
        # loops from the edges
        for e in F!.nodes[j].edges do
            imgs := List( gens, x -> ImagesRepresentative( theta[ e.to ][2],
                        ImagesRepresentative( e.map, ImagesRepresentative( theta[j][1], x ) ) ) );
            Add( res, GroupHomomorphismByImagesNC( R, R, gens, imgs ) );
        od;
    od;
    res := Filtered( res, a -> not IsOne( a ) );
    # remove duplicates
    res := DuplicateFreeList( res );
    node.autF := res;
    return res;
end );

#############################################################################
##
#F  FS_AutFGenerators( <F>, <P> ) . . . . . . . .  generators of Aut_F(P), any P <= S
##
InstallGlobalFunction( FS_AutFGenerators, function( F, P )
    local pos, gens, theta;
    pos := FS_NodeOf( F, P );
    gens := FS_AutFGeneratorsOfNode( F, pos[1] );
    if pos[2] = One( F!.S ) and F!.nodes[ pos[1] ].rep = P then return gens; fi;
    # theta: rep -> P, x -> x^(s^-1)
    theta := GroupHomomorphismByImagesNC( F!.nodes[ pos[1] ].rep, P, FS_PcgsOf( F!.nodes[ pos[1] ].rep ),
                 List( FS_PcgsOf( F!.nodes[ pos[1] ].rep ), x -> x ^ ( pos[2]^-1 ) ) );
    return List( gens, a -> FS_TransportAut( a, theta ) );
end );

#############################################################################
##
#M  AutF( <F>, <P> )
##
InstallMethod( AutF, [ IsFusionSystem, IsGroup ], function( F, P )
    return FS_AutGroupByGenerators( Concatenation( FS_AutSGenerators( F, P ), FS_AutFGenerators( F, P ) ), P );
end );

#############################################################################
##
#M  FConjugacyClass( <F>, <P> ) . . . . . . .  all F-conjugates of P (a list of subgroups)
##
InstallMethod( FConjugacyClass, [ IsFusionSystem, IsGroup ], function( F, P )
    local pos, comp, res, j;
    pos := FS_NodeOf( F, P );
    comp := FS_ComponentOf( F, pos[1] );
    res := [];
    for j in comp do
        Append( res, AsList( ConjugacyClassSubgroups( F!.S, F!.nodes[j].rep ) ) );
    od;
    return res;
end );

InstallMethod( IsFConjugate, [ IsFusionSystem, IsGroup, IsGroup ], function( F, P, Q )
    local i, j;
    if Size( P ) <> Size( Q ) then return false; fi;
    i := FS_NodeOf( F, P )[1]; j := FS_NodeOf( F, Q )[1];
    if i = j then return true; fi;
    return j in FS_ComponentOf( F, i );
end );

#############################################################################
##
#M  FIsomorphism( <F>, <P>, <Q> ) . . . . . an isomorphism P -> Q in F, or fail
##
InstallMethod( FIsomorphism, [ IsFusionSystem, IsGroup, IsGroup ], function( F, P, Q )
    local pi, qi, comp, theta, gens;
    if Size( P ) <> Size( Q ) then return fail; fi;
    pi := FS_NodeOf( F, P ); qi := FS_NodeOf( F, Q );
    comp := FS_ComponentOf( F, pi[1] );
    if not qi[1] in comp then return fail; fi;
    theta := FS_IsoToNode( F, comp, pi[1] );
    gens := FS_PcgsOf( P );
    return GroupHomomorphismByImagesNC( P, Q, gens,
        List( gens, x -> ImagesRepresentative( theta[ qi[1] ][1], x ^ pi[2] ) ^ ( qi[2]^-1 ) ) );
end );

InstallMethod( IsFCentric, [ IsFusionSystem, IsGroup ], function( F, P )
    local comp;
    comp := FS_ComponentOf( F, FS_NodeOf( F, P )[1] );
    return ForAll( comp, j -> F!.nodes[j].centric );
end );

InstallMethod( IsFullyNormalized, [ IsFusionSystem, IsGroup ], function( F, P )
    local pos, comp;
    pos := FS_NodeOf( F, P );
    comp := FS_ComponentOf( F, pos[1] );
    return ForAll( comp, j -> F!.nodes[j].nS <= F!.nodes[ pos[1] ].nS );
end );

InstallMethod( IsFullyCentralized, [ IsFusionSystem, IsGroup ], function( F, P )
    local pos, comp;
    pos := FS_NodeOf( F, P );
    comp := FS_ComponentOf( F, pos[1] );
    return ForAll( comp, j -> F!.nodes[j].inv[3] <= F!.nodes[ pos[1] ].inv[3] );
end );

InstallMethod( IsFullyAutomized, [ IsFusionSystem, IsGroup ], function( F, P )
    local h, A, T;
    h := FS_AutHandle( P );
    A := FS_AutSubgroup( h, Concatenation( FS_AutSGenerators( F, P ), FS_AutFGenerators( F, P ) ) );
    T := FS_AutSubgroup( h, FS_AutSGenerators( F, P ) );
    return Size( T ) = FS_PPart( Size( A ), F!.p );
end );

InstallMethod( IsFRadical, [ IsFusionSystem, IsGroup ], function( F, P )
    local h, A;
    h := FS_AutHandle( P );
    A := FS_AutSubgroup( h, Concatenation( FS_AutSGenerators( F, P ), FS_AutFGenerators( F, P ) ) );
    return Size( PCore( A, F!.p ) ) = Index( P, Center( P ) );
end );

#############################################################################
##
#F  FS_BClassPosition( <F>, <reps>, <invs>, <X> )
##
##  Returns [ j, c, s ] with Image( c, X )^s = reps[j] for an element c of
##  the complement C (so that c, s generate B-conjugacy), or fail.
##
InstallGlobalFunction( FS_BClassPosition, function( F, reps, invs, X )
    local c, pos;
    for c in FS_ComplementElements( F ) do
        pos := FS_ClassPosition( F!.S, reps, invs, ImagesSet( c, X ) );
        if pos <> fail then return [ pos[1], c, pos[2] ]; fi;
    od;
    return fail;
end );
