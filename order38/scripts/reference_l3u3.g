#############################################################################
##
##  reference_l3u3.g                                    order 3^8 project
##
##  The 3-fusion systems of G = PSL_3(q) (3^k || q-1), G = PSU_3(q)
##  (3^k || q+1) and of their extensions G.2 by the graph (linear case) or
##  field (unitary case) automorphism, on the Sylow 3-subgroup
##      S = (T_3 : <c>) / Z,    T_3 = { diag(a,b,c) : a,b,c in C_{3^k}, abc = 1 },
##  c the 3-cycle permutation matrix and Z = <omega I>.
##
##  G is never represented as a permutation group (PSL_3(163) has smallest
##  degree 26 733 and PSU_3(647) is far beyond reach).  Instead everything
##  happens in the centraliser of the central element z = diag(1,omega,omega^2)Z
##  of S, which is the monomial group M/Z, M = T : <c> (|M| = 3(q -+ 1)^2):
##  for U <= S with z in Z(U), N_G(U) is generated by N_{M/Z}(U) together with
##  one element g_y in N_G(U) with z^{g_y} = y for each y in the N_G(U)-orbit
##  of z.  Such g_y are found as g_y = h g_0 where g_0 in G is an explicit
##  conjugator z -> y (a matrix of eigenvectors of a lift of y, with
##  determinant 1 and, in the unitary case, orthonormal rows) and h in M/Z
##  conjugates U to U^{g_0^-1} <= C_G(z) = M/Z.  The extension G.2 is handled
##  in a 6-dimensional matrix model (g -> diag(g, g^-T) for the graph
##  automorphism, restriction of scalars to GF(q) for the field automorphism).
##
##  The candidates for essential subgroups are the ones of Gautam's Theorem
##  3.6 (CentralSeriesCentralizers), as in GroupFusionSystem of the package.
##
Read( "/home/user/FusionSystems/order38/scripts/stage2.g" );

#############################################################################
##
#F  FS38_L3U3Data( <q>, <kind>, <ext> )
##
##  kind = "L" or "U", ext = true/false.  Returns the matrix model.
##
FS38_L3U3Data := function( q, kind, ext )
    local D, K, k, prim, nu, om, rho, lam, mu, c, d, s1, id3, Tgens, Sgens, Mgens, theta, B,
          R, Phi, iota, blockdiag, J, w, MM, isoM, Mpc, ZZ, nat, Mbar, toBar, lift6, lift3,
          conjK, Sbar, zbar, isoS, Spc, m, i, j, e;
    D := rec( q := q, kind := kind, ext := ext );
    if kind = "L" then
        K := GF( q ); prim := Z( q );
        e := q - 1;                    # the torus is C_e^2
        mu := prim;                    # generator of the group of entries
        conjK := a -> a;
    elif kind = "U" then
        K := GF( q^2 ); prim := Z( q^2 );
        e := q + 1;
        mu := prim^( q - 1 );          # generator of the norm one subgroup
        conjK := a -> a^q;
    else
        Error( "kind must be \"L\" or \"U\"" );
    fi;
    if e mod 9 <> 0 then Error( "9 must divide q -+ 1" ); fi;
    k := 0; while e mod 3^( k + 1 ) = 0 do k := k + 1; od;
    D.k := k; D.K := K; D.prim := prim; D.conjK := conjK; D.e := e;
    om := mu^( e / 3 );  rho := mu^( e / 9 );  lam := mu^( e / 3^k );
    D.om := om; D.rho := rho;
    id3 := IdentityMat( 3, K );
    D.id3 := id3;
    c := PermutationMat( (1,2,3), 3, K );
    d := DiagonalMat( [ One( K ), om, om^2 ] );
    s1 := [ [ -1, 0, 0 ], [ 0, 0, 1 ], [ 0, 1, 0 ] ] * One( K );
    D.c := c; D.d := d; D.s1 := s1;
    Tgens := [ DiagonalMat( [ mu, mu^-1, One( K ) ] ), DiagonalMat( [ One( K ), mu, mu^-1 ] ) ];
    Sgens := [ DiagonalMat( [ lam, lam^-1, One( K ) ] ), DiagonalMat( [ One( K ), lam, lam^-1 ] ), c ];
    Mgens := Concatenation( Tgens, [ c ] );
    # the 6-dimensional model over GF(q)
    blockdiag := function( A, B2 )
        local n, m, i, j, res;
        n := Length( A ); m := Length( B2 );
        res := NullMat( n + m, n + m, GF( q ) );
        for i in [ 1 .. n ] do for j in [ 1 .. n ] do res[i][j] := A[i][j]; od; od;
        for i in [ 1 .. m ] do for j in [ 1 .. m ] do res[n+i][n+j] := B2[i][j]; od; od;
        return res;
    end;
    if kind = "L" then
        iota := g -> blockdiag( g, TransposedMat( g^-1 ) );
        J := NullMat( 6, 6, K );
        for i in [ 1 .. 3 ] do J[i][3+i] := One( K ); J[3+i][i] := One( K ); od;
        w := J * iota( s1 );
        lift3 := function( m )
            local g;
            g := m{[1..3]}{[1..3]};
            if m{[1..3]}{[4..6]} <> NullMat( 3, 3, K ) or m{[4..6]}{[1..3]} <> NullMat( 3, 3, K ) then return fail; fi;
            return g;
        end;
    else
        theta := prim;
        B := Basis( AsVectorSpace( GF( q ), K ), [ One( K ), theta ] );
        R := a -> [ Coefficients( B, a ), Coefficients( B, theta * a ) ];
        Phi := [ Coefficients( B, One( K ) ), Coefficients( B, theta^q ) ];
        iota := function( g )
            local res, i, j, blk, r, s;
            res := NullMat( 6, 6, GF( q ) );
            for i in [ 1 .. 3 ] do for j in [ 1 .. 3 ] do
                blk := R( g[i][j] );
                for r in [ 1, 2 ] do for s in [ 1, 2 ] do res[2*i-2+r][2*j-2+s] := blk[r][s]; od; od;
            od; od;
            return res;
        end;
        w := blockdiag( blockdiag( Phi, Phi ), Phi ) * iota( s1 );
        lift3 := function( m )
            local g, i, j, b;
            g := NullMat( 3, 3, K );
            for i in [ 1 .. 3 ] do for j in [ 1 .. 3 ] do
                b := m[2*i-1][2*j-1] * One( K ) + m[2*i-1][2*j] * theta;
                if [ m[2*i-1][2*j], m[2*i][2*j-1], m[2*i][2*j] ] <> [ Coefficients( B, b )[2], Coefficients( B, theta * b )[1], Coefficients( B, theta * b )[2] ] then return fail; fi;
                g[i][j] := b;
            od; od;
            return g;
        end;
    fi;
    D.iota := iota; D.lift3 := lift3; D.w := w;
    if ext then
        MM := Group( Concatenation( List( Mgens, iota ), [ w ] ) );
    else
        MM := Group( List( Mgens, iota ) );
    fi;
    D.MM := MM;
    isoM := IsomorphismPcGroup( MM );
    Mpc := Image( isoM );
    ZZ := Group( Image( isoM, iota( om * id3 ) ) );
    nat := NaturalHomomorphismByNormalSubgroup( Mpc, ZZ );
    Mbar := Image( nat );
    toBar := m -> Image( nat, Image( isoM, m ) );
    lift6 := x -> PreImagesRepresentative( isoM, PreImagesRepresentative( nat, x ) );
    D.isoM := isoM; D.Mpc := Mpc; D.nat := nat; D.Mbar := Mbar; D.toBar := toBar; D.lift6 := lift6;
    Sbar := Group( List( Sgens, g -> toBar( iota( g ) ) ) );
    zbar := toBar( iota( d ) );
    if Size( Sbar ) <> 3^( 2 * k ) then Error( "wrong Sylow order" ); fi;
    if not zbar in Centre( Sbar ) or Order( zbar ) <> 3 then Error( "z is not central of order 3" ); fi;
    if Size( Mbar ) <> ( 1 + Number( [ ext ], x -> x ) ) * 3 * e^2 / 3 then Error( "wrong order of M/Z" ); fi;
    isoS := IsomorphismPcGroup( Sbar );
    Spc := Image( isoS );
    D.Sbar := Sbar; D.zbar := zbar; D.isoS := isoS; D.Spc := Spc;
    return D;
end;

#############################################################################
##
#F  FS38_L3U3ConjugatorFromZ( <D>, <ym> )
##
##  ym a 3x3 matrix in SL_3 / SU_3 of order 3 modulo scalars.  Returns a
##  matrix g in SL_3 / SU_3 with g^-1 d g = ym * scalar, or fail if ym is not
##  conjugate to d modulo scalars.
##
FS38_L3U3ConjugatorFromZ := function( D, ym )
    local K, q, sigma, j, mu0, rows, i, V, P, v, n, a, L, det;
    K := D.K; q := D.q;
    sigma := ( ym^3 )[1][1];
    if ym^3 <> sigma * D.id3 then return fail; fi;
    j := Position( [ One( K ), D.om, D.om^2 ], sigma );
    if j = fail then return fail; fi;
    mu0 := D.rho^( j - 1 );
    rows := [];
    for i in [ 0 .. 2 ] do
        V := NullspaceMat( ym - mu0 * D.om^i * D.id3 );
        if Length( V ) <> 1 then return fail; fi;
        Add( rows, ShallowCopy( V[1] ) );
    od;
    if D.kind = "U" then
        for i in [ 1 .. 3 ] do
            v := rows[i];
            n := Sum( List( v, x -> x^( q + 1 ) ) );   # the hermitian norm, in GF(q)
            if IsZero( n ) then Error( "isotropic eigenvector" ); fi;
            L := LogFFE( n^-1, D.prim );
            if L mod ( q + 1 ) <> 0 then Error( "norm not in GF(q)" ); fi;
            a := D.prim^( L / ( q + 1 ) );            # a^(q+1) = n^-1
            rows[i] := a * v;
        od;
    fi;
    P := rows;
    det := DeterminantMat( P );
    P[1] := det^-1 * P[1];
    P := Immutable( P );
    if D.kind = "U" then
        if P * TransposedMat( List( P, r -> List( r, D.conjK ) ) ) <> D.id3 then Error( "conjugator not unitary" ); fi;
    fi;
    if P^-1 * D.d * P <> mu0^-1 * ym then Error( "conjugator wrong" ); fi;
    return P;
end;

#############################################################################
##
#F  FS38_L3U3Normalizer( <D>, <Ubar> )
##
##  Ubar <= Sbar <= Mbar with zbar in Z(Ubar).  Returns rec( auts, size,
##  orbit ) where auts generate Aut_G(U) (as automorphisms of the subgroup
##  Image( isoS, Ubar ) of Spc), size = |N_G(U)| and orbit is the N_G(U)-orbit
##  of z in Z(U).
##
FS38_L3U3Normalizer := function( D, Ubar )
    local NU, gens6, extra, orbit, failed, y, ym, P, g0, Ugens6, imgs, Ubar2, h, gy,
          Upc, gensU, auts, m, images;
    NU := Normalizer( D.Mbar, Ubar );
    gens6 := List( GeneratorsOfGroup( NU ), D.lift6 );
    Ugens6 := List( GeneratorsOfGroup( Ubar ), D.lift6 );
    extra := []; orbit := [ D.zbar ]; failed := [];
    for y in Elements( Centre( Ubar ) ) do
        if Order( y ) <> 3 or y in orbit or y in failed then continue; fi;
        ym := D.lift3( D.lift6( y ) );
        if ym = fail then Error( "lift of an element of G is not in M" ); fi;
        P := FS38_L3U3ConjugatorFromZ( D, ym );
        if P = fail then Append( failed, Orbit( NU, y ) ); continue; fi;
        g0 := D.iota( P );
        imgs := List( Ugens6, u -> g0 * u * g0^-1 );
        if not ForAll( imgs, m -> m in D.MM ) then Error( "U^(g0^-1) does not centralise z" ); fi;
        Ubar2 := Group( List( imgs, D.toBar ) );
        h := RepresentativeAction( D.Mbar, Ubar, Ubar2 );
        if h = fail then Append( failed, Orbit( NU, y ) ); continue; fi;
        gy := D.lift6( h ) * g0;
        Add( extra, gy );
        Append( orbit, Orbit( NU, y ) );
        orbit := Set( orbit );
    od;
    Upc := Image( D.isoS, Ubar );
    gensU := List( GeneratorsOfGroup( Ubar ), x -> Image( D.isoS, x ) );
    auts := [];
    for m in Concatenation( gens6, extra ) do
        images := List( Ugens6, u -> m^-1 * u * m );
        if not ForAll( images, x -> x in D.MM ) then Error( "conjugate not in M" ); fi;
        images := List( images, x -> Image( D.isoS, D.toBar( x ) ) );
        if not ForAll( images, x -> x in Upc ) then Error( "element does not normalise U" ); fi;
        Add( auts, GroupHomomorphismByImagesNC( Upc, Upc, gensU, images ) );
    od;
    return rec( auts := auts, size := Size( NU ) * Length( orbit ), orbit := orbit, Upc := Upc );
end;

#############################################################################
##
#F  FS38_L3U3FusionSystem( <q>, <kind>, <ext> )
##
##  The fusion system F_S(G) (as a fusion system on the pc group D.Spc)
##  together with the data of the essential subgroups.
##
FS38_L3U3FusionSystem := function( q, kind, ext )
    local D, Spc, rS, cands, reps, invs, ess, essauts, info, U, Ubar, r, hE, A, cG, natA, Out, F;
    D := FS38_L3U3Data( q, kind, ext );
    Spc := D.Spc;
    rS := FS38_L3U3Normalizer( D, D.Sbar );
    cands := CentralSeriesCentralizers( Spc );
    reps := []; invs := []; ess := []; essauts := []; info := [];
    for U in cands do
        if U = Spc or not FS_IsCentricIn( Spc, U ) then continue; fi;
        if FS_ClassPosition( Spc, reps, invs, U ) <> fail then continue; fi;
        Add( reps, U ); Add( invs, FS_SubgroupInvariants( Spc, U ) );
        if not FS_CheapProtoEssentialTest( Spc, U ) then continue; fi;
        Ubar := PreImage( D.isoS, U );
        r := FS38_L3U3Normalizer( D, Ubar );
        # fully normalised
        if FS_PPart( r.size, 3 ) <> Size( Normalizer( Spc, U ) ) then
            Add( info, rec( order := Size( U ), NG := r.size, status := "not fully normalised" ) ); continue;
        fi;
        hE := FS_AutHandle( r.Upc );
        A := FS_AutSubgroup( hE, r.auts );
        # 3-centric: |C_G(U)| = |N_G(U)| / |Aut_G(U)|
        cG := r.size / Size( A );
        if FS_PPart( cG, 3 ) <> Size( Centre( U ) ) then
            Add( info, rec( order := Size( U ), NG := r.size, AutG := Size( A ), status := "not centric" ) ); continue;
        fi;
        natA := NaturalHomomorphismByNormalSubgroup( A, FS_AutInn( hE ) );
        Out := Image( natA );
        if not HasStronglyPEmbeddedSubgroup( Out, 3 ) then
            Add( info, rec( order := Size( U ), NG := r.size, AutG := Size( A ), OutG := Size( Out ), status := "Out_G(U) has no strongly 3-embedded subgroup" ) ); continue;
        fi;
        Add( ess, r.Upc ); Add( essauts, r.auts );
        Add( info, rec( order := Size( U ), NG := r.size, AutG := Size( A ), OutG := Size( Out ),
                        OutGdesc := StructureDescription( Out ), index := Index( Normalizer( Spc, U ), U ), status := "essential" ) );
    od;
    F := FusionSystem( Spc, rS.auts, ess, essauts );
    return rec( F := F, D := D, info := info, NGS := rS.size );
end;

#############################################################################
##
#F  FS38_L3U3Run( <list>, <logfile> )
##
##  list of [ q, kind, ext, name ].  Computes the fusion systems, checks
##  saturation and O_3(F) = 1, describes them, and compares them with the
##  list AllFusionSystems( Spc ) of the first entry.
##
FS38_L3U3Run := function( list, logfile )
    local out, Say, refs, x, t, r, d, L, i, j, iso;
    out := OutputTextFile( logfile, false ); SetPrintFormattingStatus( out, false );
    Say := function( arg ) CallFuncList( AppendTo, Concatenation( [ out ], arg ) ); end;
    refs := [];
    for x in list do
        t := Runtime();
        r := FS38_L3U3FusionSystem( x[1], x[2], x[3] );
        Say( x[4], ": |N_G(S)| = ", r.NGS, "; candidates: ", List( r.info, i -> [ i.order, i.status ] ), " (", Runtime() - t, " ms)\n" );
        Say( "    essentials: ", List( Filtered( r.info, i -> i.status = "essential" ), i -> [ i.order, i.index, i.OutGdesc ] ), "\n" );
        Say( "    saturated: ", IsSaturated( r.F ), ", O_3(F) = 1: ", IsOpFTrivial( r.F ), ", O^3(F) = F: ", IsPPerfectFusionSystem( r.F ), "\n" );
        d := FS38_Describe( r.F );
        Say( "    ", FS38_DescLine( d ), "\n" );
        Add( refs, rec( name := x[4], F := r.F, S := r.D.Spc ) );
    od;
    # the complete list on the Sylow subgroup of the first group
    t := Runtime();
    L := AllFusionSystems( refs[1].S );
    Say( Length( L ), " fusion systems on S (", Runtime() - t, " ms)\n" );
    for i in [ 1 .. Length( L ) ] do
        Say( "F", i, ": ", FS38_DescLine( FS38_Describe( L[i] ) ), "\n" );
    od;
    for j in [ 1 .. Length( refs ) ] do
        t := Runtime();
        for i in [ 1 .. Length( L ) ] do
            if refs[j].S = refs[1].S then
                iso := FS_IsomorphismFusionSystemsSameS( L[i], refs[j].F ) <> fail;
            else
                iso := IsIsomorphicFusionSystems( L[i], refs[j].F );
            fi;
            if iso then Say( refs[j].name, " is isomorphic to F", i, " (", Runtime() - t, " ms)\n" ); fi;
        od;
    od;
    Say( "DONE\n" );
    CloseStream( out );
    return rec( refs := refs, L := L );
end;
