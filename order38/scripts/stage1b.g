#############################################################################
##
##  stage1b.g     Stage 1b: the tests needing automorphism groups, applied to
##                the survivors of Stage 1a.
##
##  For each survivor:  the proto-essential subgroups (ProtoEssentialSubgroups,
##  i.e. the candidates which also pass the radical test with Aut(E) and the
##  insolubility test, up to Aut(S)), the characteristic subgroup test (R5)
##  and the generation test (R6) with [S, O^3(Aut(S))].
##
LoadPackage( "FusionSystems", false );
LoadPackage( "sglppow", false );

# O^p(G) for a group G: the subgroup generated by all p'-elements = the
# smallest normal subgroup with p-group quotient
FS38_OpResidual := function( G, p )
    local D, gens, g, o;
    # generated by the p'-parts of all elements: use generators of G and
    # their conjugates: O^p(G) = normal closure of < g^(p-part) ... >; simpler:
    # the derived series approach: O^p(G) = intersection of the kernels of
    # homomorphisms onto p-groups = the smallest N normal with G/N a p-group.
    D := DerivedSubgroup( G );
    # G/D is abelian; O^p(G/D) is the p'-Hall part of G/D; lift it
    gens := ShallowCopy( GeneratorsOfGroup( D ) );
    for g in GeneratorsOfGroup( G ) do
        o := Order( g );
        while o mod p = 0 do o := o / p; od;
        # g^(p-part) has p'-order... we want the p'-part: g^(p^k) where p^k || Order(g)
        Add( gens, g^( Order( g ) / o ) );
    od;
    return NormalClosure( G, SubgroupNC( G, gens ) );
end;

FS38_Stage1b := function( S )
    local h, proto, r, O, gens, x, auts, t;
    t := Runtime();
    r := rec();
    h := FS_AutHandle( S );
    r.autorder := Size( h.model );
    r.autpc := h.ispc;
    proto := ProtoEssentialSubgroups( S );
    r.proto := List( proto.autreps, E -> rec( order := Size( E ), index := Index( Normalizer( S, E ), E ),
                     elab := IsElementaryAbelian( E ), abelian := IsAbelian( E ), rank := RankPGroup( E ),
                     nS := Number( proto.label, l -> l = Position( proto.autreps, E ) ) ) );
    if Length( proto.sreps ) = 0 then r.status := "reject"; r.reason := "no proto-essential subgroup (R4)"; r.time := Runtime() - t; return r; fi;
    if FS_CharacteristicSubgroupTest( proto.sreps, S ) then
        r.status := "reject"; r.reason := "characteristic subgroup in all proto-essentials (R5)"; r.time := Runtime() - t; return r;
    fi;
    # (R6) with O^3(Aut(S))
    O := FS38_OpResidual( h.model, 3 );
    r.O3AutIndex := Size( h.model ) / Size( O );
    auts := List( GeneratorsOfGroup( O ), h.from );
    x := ClosureGroup( FS_CommutatorWithAutomorphisms( S, auts ), Concatenation( List( proto.sreps, GeneratorsOfGroup ) ) );
    if Size( x ) < Size( S ) then
        r.status := "reject"; r.reason := "[S,O^3(Aut(S))] and the proto-essentials do not generate S (R6)"; r.time := Runtime() - t; return r;
    fi;
    r.status := "survive";
    r.time := Runtime() - t;
    return r;
end;

FS38_Stage1bLine := function( id, r )
    local s, c;
    s := Concatenation( String( id ), ";", r.status, ";|Aut(S)|=", String( r.autorder ), ";" );
    if IsBound( r.O3AutIndex ) then s := Concatenation( s, "|Aut:O^3|=", String( r.O3AutIndex ), ";" ); fi;
    if r.status = "reject" then s := Concatenation( s, r.reason, ";" ); fi;
    for c in r.proto do
        s := Concatenation( s, "[", String( c.order ), ",", String( c.index ), ",", String( c.elab ), ",", String( c.abelian ), ",",
                            String( c.rank ), ",", String( c.nS ), "]" );
    od;
    return Concatenation( s, ";", String( r.time ) );
end;

FS38_RunStage1b := function( ids, file )
    local id, S, r;
    for id in ids do
        S := SmallGroup( 6561, id );
        r := FS38_Stage1b( S );
        AppendTo( file, FS38_Stage1bLine( id, r ), "\n" );
    od;
end;
